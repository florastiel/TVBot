# Throwaway user account token (the "streamer"). NEVER commit the real .env.
STREAMER_TOKEN=
# Your server and the voice channel to use for the proof of concept
GUILD_ID=
VOICE_CHANNEL_ID=
# Your personal Plex token (the one from your own Plex account)
PLEX_TOKEN=
# Name of your friend's server exactly as it shows in Plex (leave blank to list them)
PLEX_SERVER_NAME=
# The controller bot's token (a normal Discord bot)
BOT_TOKEN=
# Claude API key (sorting the catalog, the weekly grid)
ANTHROPIC_API_KEY=
# Real-Debrid API token (real-debrid.com/apitoken); leave blank to not use Real-Debrid
RD_TOKEN=
